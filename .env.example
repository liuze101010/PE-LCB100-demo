POSTGRES_PASSWORD=replace-with-a-long-random-password
POLYMER_AGENT_SECRET_KEY=replace-with-at-least-32-random-bytes
POLYMER_AGENT_CREDENTIAL_KEY=replace-with-a-separate-32-byte-secret
POLYMER_AGENT_BOOTSTRAP_ADMIN=admin
POLYMER_AGENT_BOOTSTRAP_PASSWORD=replace-with-a-strong-bootstrap-password
POLYMER_AGENT_COOKIE_SECURE=1
POLYMER_AGENT_EXECUTOR_ENABLED=1
POLYMER_AGENT_DOMAIN=https://polymer-agent.example.edu

# Laboratory-managed model credentials (optional).
# Any of the four *_API_KEY values set here (or as real environment variables)
# are auto-loaded into the bootstrap admin's credentials at startup, so you do
# not need to paste them again in the web UI. Existing UI-entered keys are never
# overwritten. Set POLYMER_AGENT_SEED_KEYS_FROM_ENV=0 to disable this behaviour.
OPENAI_API_KEY=
POLYMER_AGENT_LIVE_DESIGN=1
POLYMER_AGENT_DESIGN_MODEL=gpt-5.5
POLYMER_AGENT_DESIGN_REASONING=medium
POLYMER_AGENT_UPPER_PLANNER=1
POLYMER_AGENT_UPPER_PLANNER_MODEL=gpt-5.5
POLYMER_AGENT_UPPER_PLANNER_REASONING=low
POLYMER_AGENT_REQUIRE_UPPER_PLANNER=0
POLYMER_AGENT_INTENT_PROVIDER=openai
POLYMER_AGENT_INTENT_MODEL=gpt-5.5
DEEPSEEK_API_KEY=
DASHSCOPE_API_KEY=
ZHIPUAI_API_KEY=
