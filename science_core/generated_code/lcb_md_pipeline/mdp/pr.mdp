integrator             = md
tinit                  = 0
dt                     = 0.001
comm-mode              = Linear
nsteps                 = 50000000

nstxout-compressed     = 10000
compressed-x-precision = 1000

cutoff-scheme          = Verlet
nstlist                = 10
ns_type                = grid
pbc                    = xyz
rlist                  = 1.0

coulombtype            = PME
rcoulomb               = 1.0
fourierspacing         = 0.15
pme_order              = 4
ewald_rtol             = 1e-05

vdwtype                = cut-off
rvdw                   = 1.0
DispCorr               = EnerPres

Tcoupl                 = nose-hoover
tc-grps                = system
tau_t                  = 0.5
ref_t                  = 400

pcoupl                 = Parrinello-Rahman
tau-p                  = 2.0
compressibility        = 4.5e-5
ref-p                  = 1.0

constraints            = h-bonds
